<xmpl>
<namespace name="logic">
    <define name="for">
        <arguments>
            <argument mut=false type="code" name="iterator"></argument>
            <argument mut=false type="code" name="iteration"></argument>
            <argument mut=false type="code" name="iterate"></argument>
            <argument mut=false type="code" name="do"></argument>
        </arguments>
        <body>
            <exec>
                <get name="iterator"/>
            </exec>
            <while>
                <exec>
                    <get name="iteration"/>
                </exec>
                <do>
                    <exec>
                        <get name="do"/>
                    </exec>
                    <exec>
                        <get name="iterate"/>
                    </exec>
                </do>
            </while>
        </body>
    </define>
    <define name="or">
        <arguments>
            <argument mut=false type="boolean" name="a"></argument>
            <argument mut=false type="boolean" name="b"></argument>
        </arguments>
        <body>
            <if>
                <condition>
                    <get name="a"/>
                </condition>
                <then>
                    <return>
                        <boolean>true</boolean>
                    </return>
                </then>
            </if>
            <if>
                <condition>
                    <get name="b"/>
                </condition>
                <then>
                    <return>
                        <boolean>true</boolean>
                    </return>
                </then>
            </if>
            <return>
                <boolean>false</boolean>
            </return>
        </body>
    </define>
    <define name="and">
        <arguments>
            <argument mut=false type="boolean" name="a"></argument>
            <argument mut=false type="boolean" name="b"></argument>
        </arguments>
        <body>
            <if>
                <condition>
                    <get name="a"/>
                </condition>
                <then>
                    <if>
                        <condition>
                            <get name="b"/>
                        </condition>
                        <then>
                            <return>
                                <boolean>true</boolean>
                            </return>
                        </then>
                    </if>
                </then>
            </if>
            <return>
                <boolean>false</boolean>
            </return>
        </body>
    </define>
    <define name="not">
        <arguments>
            <argument mut=false type="boolean" name="a"></argument>
        </arguments>
        <body>
            <if>
                <condition>
                    <get name="a"/>
                </condition>
                <then>
                    <return>
                        <boolean>false</boolean>
                    </return>
                </then>
            </if>
            <return>
                <boolean>true</boolean>
            </return>
        </body>
    </define>
    <define name="pass">
        <arguments>
            <argument mut=false type="string" name="type"><string></string></argument>
        </arguments>
        <body>
            <if>
                <condition>
                    <equal>
                        <get name="type"/>
                        <string>int</string>
                    </equal>
                </condition>
                <then>
                    <return>
                        <int>0</int>
                    </return>
                </then>
            </if>
            <if>
                <condition>
                    <equal>
                        <get name="type"/>
                        <string>string</string>
                    </equal>
                </condition>
                <then>
                    <return>
                        <string></string>
                    </return>
                </then>
            </if>
            <if>
                <condition>
                    <equal>
                        <get name="type"/>
                        <string>boolean</string>
                    </equal>
                </condition>
                <then>
                    <return>
                        <boolean>false</boolean>
                    </return>
                </then>
            </if>
            <return></return>
        </body>
    </define>
</namespace>
</xmpl>