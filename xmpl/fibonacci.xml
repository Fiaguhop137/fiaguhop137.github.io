<import namespace="io"/>
<import namespace="math"/>
<import namespace="logic"/>
<let mut=true type="int" name="x">0</let>
<let mut=true type="int" name="y">1</let>
<let mut=true type="int" name="z">1</let>
<let mut=false type="int" name="num"><cast type="int"><input namespace="io">Enter a number: </input></cast></let>
<for namespace="logic">
    <iterator>
        <let mut=true type="int" name="i">0</let>
    </iterator>
    <iteration>
        <less_than namespace="math">
            <get name="i"/>
            <get name="num"/>
        </less_than>
    </iteration>
    <iterate>
        <set name="i">
            <add namespace="math">
                <get name="i"/>
                <int>1</int>
            </add>
        </set>
    </iterate>
    <do>
        <print namespace="io">
            <get name="z"/>
        </print>
        <set name="z">
            <add namespace="math">
                <get name="x"/>
                <get name="y"/>
            </add>
        </set>
        <set name="x">
            <get name="y"/>
        </set>
        <set name="y">
            <get name="z"/>
        </set>
    </do>
</for>