<import namespace="io"/>
<import namespace="math"/>
<import namespace="logic"/>
<let mut=false type="int" name="x">10</let>
<print namespace="io">
    <get name="x"/>
</print>
<for namespace="logic">
    <iterator>
        <let mut=true type="int" name="i">0</let>
    </iterator>
    <iteration>
        <less_than namespace="math">
            <get name="i"/>
            <int>20</int>
        </less_than>
    </iteration>
    <iterate>
        <set name="i">
            <add namespace="math">
                <get name="i"/>
                <int>1</int>
            </add>
        </set>
    </iterate>
    <do>
        <if>
            <condition>
                <equal>
                    <get name="i"/>
                    <int>10</int>
                </equal>
            </condition>
            <then>
                <print namespace="io">i is 10</print>
            </then>
            <else>
                <print namespace="io">i is not 10</print>
            </else>
        </if>
    </do>
</for>
<namespace>
    <name>meow</name>
    <let mut=false type="int" name="cats">5</let>
    <define>
        <name>print_cats</name>
        <arguments>
            <argument mut=false type="int" name="num">0</argument>
        </arguments>
        <body>
            <for namespace="logic">
                <iterator>
                    <let mut=true type="int" name="i">0</let>
                </iterator>
                <iteration>
                    <less_than namespace="math">
                        <get name="i"/>
                        <get name="num"/>
                    </less_than>
                </iteration>
                <iterate>
                    <set name="i">
                        <add namespace="math">
                            <get name="i"/>
                            <int>1</int>
                        </add>
                    </set>
                </iterate>
                <do>
                    <print namespace="io">meow</print>
                </do>
            </for>
        </body>
    </define>
</namespace>
<print_cats namespace="meow">
    <get name="cats" namespace="meow"/>
</print_cats>