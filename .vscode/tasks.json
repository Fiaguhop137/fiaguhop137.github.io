{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C: build bternary",
            "command": "/usr/bin/gcc",
            "args": [
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "${workspaceFolder}/bternary.c",
                "-o",
                "${workspaceFolder}/bternary"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build bternary with gcc"
        }
    ]
}
